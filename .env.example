APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DB_USER=publication_monitor
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=publication_monitor

# Optional full SQLAlchemy URL; overrides DB_* variables.
# DATABASE_URL=postgresql+psycopg://publication_monitor:password@127.0.0.1:5432/publication_monitor

SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_SECONDS=28800
MAX_UPLOAD_BYTES=20971520

# Rate limiting. In production use a shared Redis URI for multiple workers.
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=10 per minute; 100 per hour

# Optional mail notifications.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
APPLICATION_URL=

# Optional comma-separated host allowlist, for example app.example.edu.
TRUSTED_HOSTS=
